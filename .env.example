# Africa's Talking Credentials (USSD & SMS)
# In production, set to your live AT username and API key.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_WEBHOOK_SECRET=

# Telegram Bot (Development / Testing)
TELEGRAM_BOT_TOKEN=

# Django Core Settings
# In production (DJANGO_ENV=production), DJANGO_SECRET_KEY must be set.
# If DJANGO_ENV=production, DEBUG is forced to False.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DEBUG=True

# ALLOWED_HOSTS
# Comma-separated hosts allowed to access the site.
# Must NOT contain '*' in production.
# E.g. ALLOWED_HOSTS=factorypulse.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# CSRF Trusted Origins
# Comma-separated list of trusted origins for CSRF checks.
# E.g. CSRF_TRUSTED_ORIGINS=https://factorypulse.example.com,https://*.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# PostgreSQL Database (Docker Compose)
POSTGRES_DB=factorypulse_db
POSTGRES_USER=factorypulse
POSTGRES_PASSWORD=factorypulse_pass
DATABASE_URL=postgres://factorypulse:factorypulse_pass@db:5432/factorypulse_db
